# === Azure OpenAI Configuration ===
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_EMBEDDING_API_KEY=your_azure_openai_embedding_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-endpoint.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15
AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_OPENAI_TEMPERATURE=0.1


# === Pinecone Configuration ===
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1 
PINECONE_INDEX_NAME=your-index-name
EDUCATIONAL_DATA_INDEX_NAME=your-educational-index-name
