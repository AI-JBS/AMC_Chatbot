# Frontend Environment Variables
# Production API URL (commented out for local development)
NEXT_PUBLIC_API_URL=https://jbs-ai.com/amc_api

# Local development API URL (matches backend port 8022)
# NEXT_PUBLIC_API_URL=http://localhost:8022

NEXT_PUBLIC_APP_NAME="Asset Management Chatbot"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Development settings
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1